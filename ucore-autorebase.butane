variant: fcos
version: 1.7.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP/MK+0IbBRjPc4x7FK/eTKzSPvQNabDxQHiIdbhwT/1
      password_hash: $passhash
      groups: 
        - podmanconfig
  groups:
    - name: podmanconfig
storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754
    - path: /var/mnt/backup-drive
      mode: 0644
  trees:
    - path: /etc/containers
      local: containers
      file_mode: 0664
      dir_mode: 0664
      user:
        name: root
      group:
        name: podmanconfig

systemd:
  units:
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents_local: services/ucore-unsigned-autorebase.service
    - name: ucore-signed-autorebase.service
      enabled: true
      contents_local: services/ucore-signed-autorebase.service
    - name: podman-start.target
      enabled: true
      contents_local: services/podman-start.target
    - name: copy-podman-backups.service
      enabled: true
      contents_local: services/copy-podman-backups.service
