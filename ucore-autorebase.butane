variant: fcos
version: 1.4.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP/MK+0IbBRjPc4x7FK/eTKzSPvQNabDxQHiIdbhwT/1
      password_hash: $passhash
storage:
  disks:
      # TODO: Update disk ids
    - device: /dev/disk/by-id/$diskaid
      wipe_table: true
      partitions:
        - label: "raid.1.1"
          number: 1
          size_mib: 0
          start_mib: 0
    - device: /dev/disk/by-id/$diskbid
      wipe_table: true
      partitions:
        - label: "raid.1.2"
          number: 1
          size_mib: 0
          start_mib: 0
  filesystems:
    - path: /var/home/users/core/.local/share/containers/storage
      # Not sure if this will work. Depends on how stuff is passed to mkfs. Maybe?
      device: "/dev/disk/by-partlabel/raid.1.1 /dev/disk/by-partlabel/raid.1.2"
      format: btrfs
      label: container-storage
      options:
        - "-m raid1"
        - "-d raid1"
      mount_options:
        - "compress=zstd"
        - "subvol=@"
      with_mount_unit: true 
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754
    - path: /home/core/.config/containers
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd/foundryvtt
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd/homeassistant
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd/vaultwarden
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd/workcal
      user:
        name: core
      group:
        name: core
  files:
    - path: /etc/NetworkManager/system-connections/$ethname.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=$ethname
          type=ethernet
          interface-name=$ethname
          [ipv4]
          address1=172.21.85.5/24,172.21.85.1
          dns=8.8.8.8;
          dns-search=
          may-fail=false
          method=manual
    - path: /home/core/.config/containers/storage.conf
      contents:
        inline: |
          [storage]
          
          driver = "btrfs"
        user:
          name: core
        group:
          name: core
    - path: /home/core/.config/containers/systemd/foundryvtt/foundryvtt.volume
      contents:
        inline: |
          [Volume]
        user:
          name: core
        group:
          name: core
    - path: /home/core/.config/containers/systemd/homeassistant/homeassistant.volume
      contents:
        inline: |
          [Volume]
        user:
          name: core
        group:
          name: core
    - path: /home/core/.config/containers/systemd/homeassistant/mosquitto.volume
      contents:
        inline: |
          [Volume]
        user:
          name: core
        group:
          name: core
    - path: /home/core/.config/containers/systemd/homeassistant/zwavejs.volume
      contents:
        inline: |
          [Volume]
        user:
          name: core
        group:
          name: core
    - path: /home/core/.config/containers/systemd/vaultwarden/vaultwarden.volume
      contents:
        inline: |
          [Volume]
        user:
          name: core
        group:
          name: core
    - path: /home/core/.config/containers/systemd/workcal/workcal.volume
      contents:
        inline: |
          [Volume]
        user:
          name: core
        group:
          name: core

systemd:
  units:
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
