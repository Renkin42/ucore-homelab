variant: fcos
version: 1.7.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP/MK+0IbBRjPc4x7FK/eTKzSPvQNabDxQHiIdbhwT/1
      password_hash: $passhash
      groups: 
        - podmanconfig
  groups:
    - name: podmanconfig
storage:
  disks:
    - device: /dev/disk/by-id/$diskaid
      wipe_table: true
      partitions:
        - label: "raid.1.1"
          number: 1
          size_mib: 0
          start_mib: 0
    - device: /dev/disk/by-id/$diskbid
      wipe_table: true
      partitions:
        - label: "raid.1.2"
          number: 1
          size_mib: 0
          start_mib: 0
  filesystems:
    - path: /var/lib/containers/storage
      device: /dev/disk/by-partlabel/raid.1.1
      format: btrfs
      label: container-storage
      mount_options:
        - "compress=zstd"
        - "subvol=@"
      with_mount_unit: true
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754
    - path: /var/mnt/backup-drive
      mode: 0644
  trees:
    - path: /etc/containers
      local: containers
      file_mode: 0664
      dir_mode: 0664
      user:
        name: root
      group:
        name: podmanconfig

systemd:
  units:
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents_local: services/ucore-unsigned-autorebase.service
    - name: ucore-signed-autorebase.service
      enabled: true
      contents_local: services/ucore-signed-autorebase.service
    - name: btrfs-convert-raid1.service
      enabled: true
      contents_local: services/btrfs-convert/raid1.service
    - name: podman-start.target
      enabled: true
      contents_local: services/podman-start.target
    - name: copy-podman-backups.service
      enabled: true
      contents_local:services/copy-podman-backups.service
